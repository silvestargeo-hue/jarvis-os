# Convex deployment (run `npx convex dev` to generate)
NEXT_PUBLIC_CONVEX_URL=

# Cloud AI (OpenRouter). Server-only — used inside Convex actions via ctx.runAction? No:
# OpenRouter calls happen client-side or via a Convex action using fetch with this env var.
OPENROUTER_API_KEY=
# Comma-separated allowlist, e.g. "anthropic/claude-3.5-sonnet,meta-llama/llama-3.3-70b-instruct"
OPENROUTER_ALLOWED_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o-mini

# Optional: model ids
NEXT_PUBLIC_WEBLLM_MODEL=Qwen2.5-1.5B-Instruct-q4f16_1-MLC
NEXT_PUBLIC_OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
